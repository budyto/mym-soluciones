# Los moldes y las fichas de los clientes son material de trabajo: no se sirven por la web.
# Lo que se ve en el navegador es lo generado (carpeta /muestras/ o el dominio de cada cliente).
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
