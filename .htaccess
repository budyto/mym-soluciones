# El HTML nunca se guarda en caché: así siempre pide los CSS/JS con la versión nueva (?v=...)
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# (4/11/2026) /resenas se dio de baja (Budy no quiere reseñas): Hostinger no borra lo que sale del repo,
# así que la carpeta entera queda bloqueada. Se puede borrar a mano desde el administrador de archivos.
# (2/11/2026) Archivos internos que no tienen que poder bajarse desde la web:
# instrucciones (CLAUDE.md), esquemas SQL, datos de reseñas (incluye las ocultas) y archivos ocultos.
<IfModule mod_alias.c>
  RedirectMatch 403 \.(md|sql)$
  RedirectMatch 403 ^/resenas(/|$)
  RedirectMatch 403 (^|/)\.(?!well-known/)
</IfModule>

# (13/11/2026) La planilla de ejemplo de la guía TAREA tiene que bajar como Excel y no como texto (sin esto Hostinger
# la mandaba como text/plain y en el celular podía abrirse como basura en vez de descargarse).
<IfModule mod_mime.c>
  AddType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet .xlsx
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.xlsx$">
    Header set Content-Disposition "attachment"
  </FilesMatch>
</IfModule>
