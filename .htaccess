# El HTML nunca se guarda en caché: así siempre pide los CSS/JS con la versión nueva (?v=...)
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # (25/11/2026) El service worker del panel (admin/sw.js) y el manifest no llevan ?v=: si quedaran un año en caché,
  # un arreglo de los avisos no llegaría nunca a los celulares. Van sin caché, como el HTML.
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# (25/11/2026) El manifest del panel instalable (admin/manifest.webmanifest) tiene que salir con su tipo.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# (4/11/2026) /resenas se dio de baja (Budy no quiere reseñas): Hostinger no borra lo que sale del repo,
# así que la carpeta entera queda bloqueada. Se puede borrar a mano desde el administrador de archivos.
# (2/11/2026) Archivos internos que no tienen que poder bajarse desde la web:
# instrucciones (CLAUDE.md), esquemas SQL, datos de reseñas (incluye las ocultas) y archivos ocultos.
<IfModule mod_alias.c>
  RedirectMatch 403 \.(md|sql)$
  RedirectMatch 403 ^/resenas(/|$)
  RedirectMatch 403 (^|/)\.(?!well-known/)
  # (14/11/2026, revisión de seguridad) Copias de respaldo, registros, scripts y configuraciones que alguien
  # pueda dejar en el servidor por error, y la carpeta de documentos internos si algún día se sube.
  # El .txt no se bloquea: robots.txt tiene que poder leerse.
  RedirectMatch 403 (?i)\.(bak|old|orig|tmp|swp|log|ini|conf|cfg|env|sh|ps1|bat|py|php~|lock|zip|rar|7z|tar|gz|psd|ai)$
  RedirectMatch 403 ^/docs-internos(/|$)
</IfModule>

# (14/11/2026, revisión de seguridad) Cabeceras de seguridad para todo el sitio.
# - HSTS: el navegador entra siempre por https (sin includeSubDomains ni preload hasta revisar los subdominios).
# - nosniff: el navegador no adivina el tipo de archivo (evita que un archivo subido se ejecute como script).
# - SAMEORIGIN y frame-ancestors: nadie puede meter la web ni el panel admin adentro de un marco ajeno
#   (clickjacking). No afecta las ventanas de Google ni de Meta, que se abren como ventana aparte.
# - Referrer-Policy: a los sitios de afuera sólo les llega el dominio, nunca la ruta (ej. admin/whatsapp.html#tel=...).
# - Permissions-Policy: la web no usa cámara, ubicación ni USB. El micrófono sí, sólo en nuestra propia web: lo usa
#   el panel de WhatsApp para grabar audios (25/11/2026, Budy: en el celular Chrome lo rechazaba sin preguntar).
#   (25/11/2026, tanda 2) La cámara sigue en camera=(): el 📷 del panel usa <input capture>, que abre la app de cámara
#   del celular y no pasa por esta política (sólo getUserMedia lo hace). Las notificaciones y el push tampoco dependen
#   de ella. Si algún día el panel filma o saca fotos dentro de la página, recién ahí pasar a camera=(self).
# - CSP en dos partes: lo que no puede romper nada se aplica ya; la lista completa de orígenes queda en modo
#   "sólo informar" (Report-Only): el navegador avisa en la consola lo que bloquearía, sin bloquearlo.
#   Cuando se sume el registro insertado de Meta hay que agregar connect.facebook.net y www.facebook.com.
#   (16/11/2026) firestore.googleapis.com: el diagnóstico de redes (diagnostico-redes/, devolucion/, demo/) guarda
#   y lee en la base del Grupo MyM; grupomym.online: la IA y la lectura de redes del panel admin/diagnosticos.html.
#   frame-src 'self': el ejemplo del formulario y la vista previa del panel muestran devolucion/ y demo/ en un recuadro.
#   Pasarla a obligatoria recién cuando la consola del panel admin (con login) y de la web no muestre avisos.
# - No se pone Cross-Origin-Opener-Policy: el login de Google (Firebase) y el de Meta usan ventanas emergentes
#   que se comunican con la página, y esa cabecera las rompe.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), usb=(), serial=(), hid=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://cdn.jsdelivr.net https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' blob:; connect-src 'self' https://firestore.googleapis.com https://grupomym.online https://mym-creditos-81440681742.southamerica-east1.run.app https://dolarapi.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://*.facebook.com https://*.run.app; frame-src 'self' https://appmym-5fdd1.firebaseapp.com https://accounts.google.com https://www.google.com https://www.facebook.com https://web.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# (13/11/2026) La planilla de ejemplo de la guía TAREA tiene que bajar como Excel y no como texto (sin esto Hostinger
# la mandaba como text/plain y en el celular podía abrirse como basura en vez de descargarse).
<IfModule mod_mime.c>
  AddType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet .xlsx
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.xlsx$">
    Header set Content-Disposition "attachment"
  </FilesMatch>
</IfModule>
